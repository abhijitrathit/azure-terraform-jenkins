
# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform working directory
**/.terraform/*

# Terraform crash logs
crash.log
crash.*.log

# Terraform variable files containing secrets
*.tfvars
*.tfvars.json
!tfvars-examples/*.tfvars

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Sensitive files and credentials
.env
.env.*
!.env.example
*.pem
*.key
credentials
credentials.json
service-account*.json
*.secret

# Plan files
*.tfplan
tfplan

# Editor and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db
